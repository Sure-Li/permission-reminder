# ============================================================
# 权限到期提醒工具 —— 版本库忽略规则
# ============================================================

# ---- 敏感配置（含邮箱授权码/密码，绝对不入库）----
config.json
**/config.json

# ---- 运行时数据与日志（本机产生的状态，不入库）----
logs/
data/
**/logs/
**/data/

# ---- Python 运行环境与缓存 ----
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# ---- PyInstaller 构建中间产物 ----
build/

# ---- 打包产物：只保留单文件 exe，其余归档/临时件不入库 ----
dist/*
!dist/权限到期提醒.exe
*.rar
*.zip
*.7z

# ---- 编辑器 / 系统 ----
.vscode/
.idea/
Thumbs.db
desktop.ini
*~
